# --- LLM (answers, query rewriting, intent detection, booking extraction) ---
LLM_PROVIDER=openai            # openai | anthropic
LLM_MODEL=gpt-4o-mini          # e.g. claude-sonnet-5-5 if LLM_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBEDDING_PROVIDER=openai      # openai | fastembed (local, free; pip install fastembed)
EMBEDDING_MODEL=text-embedding-3-small   # fastembed: BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=1536                 # fastembed bge-small: 384. MUST match the model!

# --- Infrastructure ---
DATABASE_URL=sqlite:///./app.db          # or postgresql+psycopg://user:pw@host/db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
REDIS_URL=redis://localhost:6379/0

# --- Behaviour ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_UPLOAD_MB=10
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.0
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_TTL_SECONDS=3600
TIMEZONE=UTC
