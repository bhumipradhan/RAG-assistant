# Gemini (chat + embeddings with a single key; free tier available) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash            # check AI Studio for models available to your key
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768               # MUST match the model/dimension. Changing it => new QDRANT_COLLECTION

# ============ Infrastructure ============
DATABASE_URL=sqlite:///./app.db          # or postgresql+psycopg://user:pw@host/db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
REDIS_URL=redis://localhost:6379/0

# ============ Behaviour ============
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_UPLOAD_MB=10
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.0
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_TTL_SECONDS=3600
TIMEZONE=UTC
